# Konusbitr environment.
#
# Copy to `.env` and fill in. Every variable here is validated at boot — Zod on
# the TypeScript side, pydantic-settings on the Python side — and a missing or
# malformed value fails the process immediately rather than at first use.
#
# Phase 01 only needs the first block. The rest are declared now so that the
# file is the single place to look, and are consumed by the phase named beside
# each section.

# ---------------------------------------------------------------- Phase 01 --
# "development" | "test" | "production"
NODE_ENV=development
# Public origin the web app is served from. No trailing slash.
APP_URL=http://localhost:3000

# ------------------------------------------- Phase 02 — local infrastructure --
# Postgres with the pgvector extension.
# DATABASE_URL=postgresql://konusbitr:konusbitr@localhost:5432/konusbitr
# Redis: the job queue and the progress pub/sub channel.
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------ Phase 05 — storage --
# Any S3-compatible endpoint: MinIO locally, S3/R2/B2 in production.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=konusbitr
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required for MinIO; leave false for real S3.
# S3_FORCE_PATH_STYLE=true

# --------------------------------------------------------- Phase 04 — auth --
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# ----------------------------------------------------- Phase 08 — AI router --
# Every model call goes through the LiteLLM router; never a provider SDK
# directly. Roles are configured independently.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
#
# When true, any non-local model endpoint must raise immediately. This is a
# headline claim of the project and it is tested.
# OFFLINE_MODE=false

# ------------------------------------------------------ Phase 12 — telemetry --
# Document text must never reach error reporting.
# SENTRY_DSN=
