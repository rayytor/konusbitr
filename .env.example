# Konusbitr environment.
#
# Copy to `.env` and you have a working stack: `cp .env.example .env &&
# docker compose up` needs no further edits. Every variable here is validated at
# boot — Zod on the TypeScript side (`packages/shared/src/env.ts`),
# pydantic-settings on the Python side (`konusbitr_worker.settings`) — and a
# missing or malformed value fails the process immediately rather than at first
# use.
#
# Hostnames below are `localhost`, because that is what a natively-run app needs
# (`pnpm dev:infra` publishes every backing service on its usual port). Inside
# Compose the web and worker containers reach each other by service name, so
# `docker-compose.yml` overrides DATABASE_URL, REDIS_URL, S3_ENDPOINT and
# OLLAMA_BASE_URL with container hostnames. Do not "fix" them here.
#
# The credentials are development defaults and are safe only because the stack
# is local. Change every one of them before exposing Konusbitr to a network.

# ---------------------------------------------------------------- Phase 01 --
# "development" | "test" | "production"
NODE_ENV=development
# Public origin the web app is served from. No trailing slash.
APP_URL=http://localhost:3000

# ------------------------------------------- Phase 02 — local infrastructure --
# Postgres with the pgvector extension. Konusbitr keeps everything it can here —
# embeddings, full-text search and JSONB parse artifacts — so that an operator
# has exactly one database to back up.
DATABASE_URL=postgresql://konusbitr:konusbitr@localhost:5432/konusbitr
# Redis: the job queue, the progress pub/sub channel and rate-limit counters.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------ Phase 05 — storage --
# Any S3-compatible endpoint: MinIO locally, S3/R2/B2 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=konusbitr
S3_ACCESS_KEY_ID=konusbitr
S3_SECRET_ACCESS_KEY=konusbitr-dev-secret
# Required for MinIO; set false for real S3.
S3_FORCE_PATH_STYLE=true
# The storage origin a browser can reach, when it differs from the one the
# server reaches. Leave it unset for S3/R2/B2 and for a natively-run stack;
# `docker compose` sets it for you, because inside Compose the server says
# `minio:9000` and your browser cannot.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
#
# Uploads go from the browser straight to this endpoint, so the bucket needs a
# CORS policy that allows PUT from APP_URL and *exposes the ETag header* —
# without it a multipart upload cannot report its parts. MinIO allows this by
# default; S3, R2 and B2 need it configured. See packages/storage/README.md.

# ------------------------------------------------------- Phase 05 — ingest --
# Largest file the intake path accepts, in bytes. 500MB.
MAX_UPLOAD_BYTES=524288000
# Page ceiling per document. 0 means unlimited, which is the self-host default.
MAX_PAGES=0
#
# Whether one organization's finished parse may be reused by another.
#
# Leave this false on anything multi-tenant. A shared cache is a disclosure
# channel: an organization that uploads a file and gets an instant "ready" back
# has learned that some other tenant of this instance already holds that exact
# file, byte for byte. On a single-tenant instance there is nobody to learn
# anything and the saving is free, which is the only case this is meant for.
ALLOW_GLOBAL_PARSE_CACHE=false

# --------------------------------------------------------- Phase 07 — parse --
# How much extractable text a page needs before the standard parser will trust
# it, as a fraction of the characters a page of that size would hold. A
# born-digital page scores far above this; a scan scores zero.
#
# Since Phase 12.1 this is read **per page**: a page below it is sent to the OCR
# tier rather than parsed, and a hundred-page filing with three scanned exhibits
# recognises three pages instead of all of them or none. With OCR_ENABLED=false
# it goes back to deciding the whole document, which is refused with `needs_ocr`
# when more than a fifth of its pages fall below. Raise it to be stricter.
TEXT_COVERAGE_THRESHOLD=0.1

# ----------------------------------------------------------- Phase 12.1 — OCR --
# Reading pages that have no text layer. Worker-only: recognition happens in the
# Python service and the web app has no decision to make about any of this.
#
# On by default, which is the whole of the Phase 12.1 change: a scan that used to
# be refused now parses. Turning it off restores that refusal exactly — a
# deployment that would rather see `needs_ocr` than a machine's reading of a
# photocopy is a legitimate position, and it is this one variable.
OCR_ENABLED=true

# What scanned pages are rendered at before recognition. Both engines are
# trained around 300; raising it makes pages quadratically more expensive for
# very little accuracy, and lowering it makes body text too small to read. Worth
# raising to 400 for faint 6pt footnotes on legal exhibits, and not otherwise.
OCR_DPI=300

# Primary-engine (RapidOCR) page confidence below which the fallback engine
# (Tesseract) is given the same page. The fallback's answer is taken only if it
# scores higher — an engine reached because the primary was unsure and then
# doing worse has told us something about the page, not about the primary.
OCR_FALLBACK_THRESHOLD=0.65

# Page confidence below which the viewer badges a page "verify text" rather than
# reporting it quietly. Not a failure threshold: the page is stored and indexed
# either way, because a 40%-confident reading of a faint carbon copy is still
# the best reading anyone has, and refusing it leaves the reader with nothing.
OCR_LOW_CONFIDENCE_THRESHOLD=0.85

# Whether the fallback engine is consulted at all. `false` is also what a
# deployment with no `tesseract` binary gets in practice, without having to say
# so — the default image ships one, a bare `uv sync` does not.
OCR_FALLBACK_ENABLED=true

# Whether skewed pages are straightened before recognition. On: a page fed
# through a sheet feeder at two degrees is one no line-grouping heuristic can
# assemble. The rotation is undone before any bounding box is stored.
OCR_DESKEW=true

# Tesseract traineddata names, joined with `+` (e.g. `eng+deu`). Each one needs
# its `tesseract-ocr-<lang>` package in `docker/worker.Dockerfile`.
#
# Since Phase 12.2 this is the *floor* rather than the whole answer: a document
# with `langList` set, or one the identifier recognises, adds its own packs on
# top. It is what an unrouted document is read with.
OCR_LANGUAGES=eng

# ------------------------- Phase 12.2 — languages, tables and figures --
# Multilingual routing, scanned-table reconstruction and figure extraction. All
# worker-only, for the same reason the variables above are.

# Where alternative RapidOCR recognition heads live, if any are installed.
#
# `rapidocr-onnxruntime` ships the Chinese/Latin PP-OCRv4 pair inside its wheel
# and nothing else — the Japanese, Korean, Cyrillic and Devanagari heads are
# separate downloads, and Konusbitr never fetches one at run time, because that
# would be a network call in the middle of a parse and a hole in OFFLINE_MODE.
# Drop the `.onnx` and its matching `_dict.txt` here (both, or neither is used)
# and documents in those languages stay on the primary engine; without them they
# are routed to Tesseract's language packs instead, which is a supported state
# and not a degraded one.
# OCR_MODEL_DIR=/opt/rapidocr-models

# Whether ruled tables on scanned pages are reconstructed into a grid rather
# than read as lines of prose. On. Turning it off restores the Phase 12.1
# reading, which is worse on a balance sheet and right for a corpus of ruled
# forms that are not tables at all.
OCR_TABLES_ENABLED=true

# Whether embedded images are extracted from documents and stored under
# `orgs/{orgId}/documents/{docId}/images/{n}.png`. Extraction is unconditional;
# *captioning* them needs a vision model and an upload that asked for it with
# `llm: true`, which is what VISION_PROVIDER below configures.
FIGURES_ENABLED=true

# Shortest side, in pixels, an embedded image must have to count as a figure
# rather than as a bullet, a rule or a logo. An image covering most of a page is
# filtered separately: that is the page, not a figure on it.
FIGURE_MIN_EDGE=100

# Ceiling per document, so that one pathological file cannot fill a bucket. A
# real figure-heavy document — a slide deck, a paper — runs to tens.
FIGURE_MAX_PER_DOCUMENT=200

# ------------------ Phase 12.3 — the advanced (VLM) tier & licensing --
# Tier 3. A page is *looked at* by a vision model rather than parsed, which is
# the only way to recover reading order on a multi-column magazine and the only
# stage of this pipeline whose cost scales with page count times a provider's
# token price. Hence a page ceiling and a spend cap rather than an on/off switch.
#
# What the model is trusted with is deliberately narrow: structure, reading
# order and heading hierarchy. The *characters* come from the page's own text
# layer wherever it has one, because a vision model reads 1,284,567 as 1,234,567
# and is entirely confident about it. That is the hybrid reconciliation, and it
# is why `quality: "advanced"` is safe to point at a financial statement.
#
# None of this does anything without VISION_PROVIDER / VISION_MODEL below. The
# default `.env` configures no vision role, so `quality: "advanced"` is refused
# at intake with a message saying exactly that.

# Whether `quality: "advanced"` may run at all. On — but see above: on with no
# vision model configured means "available, and asking for it tells you why you
# are not getting it", which is better than a switch that silently downgrades.
VLM_ENABLED=true

# Pages of one document the advanced parser will read before the job is refused
# with `too_many_pages`. Enforced at intake, so a 400-page filing is rejected
# before anything is spent, and again in the worker, because a job payload
# arrives from a queue rather than from the endpoint that validated it.
#
# Refusing rather than truncating to the first fifty pages is the point: a parse
# that silently covers an eighth of a document is worse than no parse.
MAX_VLM_PAGES_PER_JOB=50

# Recognition confidence below which a *single* page is escalated to the vision
# model, even on a document nobody asked to parse as `advanced`.
#
# Well below OCR_LOW_CONFIDENCE_THRESHOLD (0.85, where the viewer merely warns a
# reader), because this threshold spends money: a page has to be genuinely badly
# read — roughly two words in five guessed — before a model call is worth it.
# Set to 0 to disable escalation and make the tier strictly opt-in.
TIER_FALLBACK_THRESHOLD=0.6

# What a page is rendered at before it is shown to a vision model. Lower than
# OCR_DPI on purpose: a recogniser needs 30-40 pixels of glyph height, and a VLM
# resamples whatever it is given down to about 1568px on the long edge — so
# anything past this costs tokens and buys nothing.
VLM_DPI=180

# What one page costs on this deployment, in USD, overriding the built-in price
# table. For an operator with a negotiated rate, or a gateway whose prices are
# not the provider's. Unset means the published table, and the estimate a person
# is shown says which of the two it used.
# VLM_USD_PER_PAGE=0.02

# Ceiling on one organization's advanced-tier spend per calendar month, in USD.
# 0 means no cap, which is right for a single-tenant instance where the operator
# *is* the tenant. A multi-tenant deployment sets it, and intake then refuses a
# document whose estimate would cross it rather than discovering the overrun on
# an invoice.
ORG_MONTHLY_VLM_USD_CAP=0

# Replicas of the default worker. Set to 0 when running the `advanced` Compose
# profile, which starts a second worker built from an image containing AGPL and
# GPL parsers:
#
#   WORKER_REPLICAS=0 docker compose --profile advanced up
#
# Both consume the same Redis consumer group, so leaving this at 1 would split
# jobs between an image that has those parsers and one that does not. Read
# `docs/licensing.md` before building that image: it changes the licence of what
# you built.
WORKER_REPLICAS=1

# --------------------------------------------------------- Phase 04 — auth --
# Signs session cookies and every short-lived token — verification links, magic
# links, password resets. Rotating it signs everyone out, which is what you want
# after a leak.
#
# The value below is a development default so that `cp .env.example .env &&
# docker compose up` needs no further edits. The web app refuses to start with
# it as soon as APP_URL stops being localhost, so the moment you point a domain
# at Konusbitr you must generate your own:
#
#   openssl rand -base64 32
AUTH_SECRET=konusbitr-development-secret-change-me

# OAuth is entirely optional: with none of these set, the login page still
# renders and email + password and magic links both work. Set *both* halves of a
# pair or neither — half a pair is a boot-time error rather than a button that
# throws when someone clicks it.
#
# Callback URLs to register with the provider:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail delivery for verification, magic links, password resets and team
# invitations. With SMTP_URL unset — the default — those messages are written to
# the web server's log with their links intact, which is what you want on a
# laptop: `docker compose logs web` will show them. A deployment real people
# sign up to needs a real transport.
#
#   SMTP_URL=smtp://user:password@smtp.example.com:587
SMTP_URL=
EMAIL_FROM="Konusbitr <no-reply@localhost>"

# ------------------------------------------------------- Phase 06 — worker --
# The Python document pipeline. These have no TypeScript counterpart — the web
# app has no business knowing how many jobs the worker runs at once, in the
# same way the worker has no business knowing AUTH_SECRET.
#
# Health and readiness endpoints. Nothing in the app calls the worker; the port
# exists so that Compose, an orchestrator and an operator with curl can all ask
# whether it is alive.
WORKER_PORT=8081
# Jobs run concurrently in one worker process.
WORKER_CONCURRENCY=2
# A job that has not finished in this long is abandoned and retried.
WORKER_JOB_TIMEOUT_SECONDS=600
# Total deliveries of one job before it is dead-lettered, the first included.
# A *terminal* failure — a corrupt file, an unsupported format — never spends
# these; only retryable ones do.
WORKER_MAX_ATTEMPTS=3
# Attempt n waits base * 2^(n-1) seconds before being put back on the queue.
WORKER_RETRY_BASE_SECONDS=5
#
# Pages read, chunked and committed per batch.
#
# The unit of three things at once: how much work a crash loses, how soon the
# first pages of a long document become answerable, and how much memory a
# worker holds at its peak. Smaller batches checkpoint more often and put more
# chunk boundaries on a batch edge; larger ones lose more to a restart and make
# a reader wait longer before their first question. A document shorter than
# this is read in a single pass, which is almost every upload.
#
# Changing it invalidates checkpoints that are in flight — a resume has to land
# on the boundaries the interrupted run used — so a document being read when
# you change it is read again from the start, and the worker says so in its log.
WORKER_PAGE_BATCH_SIZE=16
#
# The worker container's memory ceiling, applied by Compose.
#
# Two gigabytes is the phase budget a 900-page scan is required to stay inside,
# and the batching above is how it is met. Declared rather than hoped for: a
# regression that starts holding a document's pages should be an OOMKilled on
# somebody's laptop, not a production incident six months later.
# WORKER_MEMORY_LIMIT=2g
#
# This worker's name in the Redis consumer group. It must be stable across
# restarts and distinct per replica: a restarted worker reclaims its own
# unacknowledged deliveries by name, which is how a job survives the container
# being killed mid-parse. Unset means the hostname, which is both of those
# things under Compose and under Kubernetes.
# WORKER_NAME=
#
# How long the Phase 06 stub pipeline pauses in each stage. Deleted along with
# the stub in Phase 07.
# WORKER_STUB_STAGE_SECONDS=0.4

# ----------------------------------------------------- Phase 08 — AI router --
# Every model call goes through one router — LiteLLM in the Python worker, the
# OpenAI-compatible client in `packages/ai` — and never a provider SDK
# directly. The four roles (chat, embedding, rerank, vision) are configured
# independently, because real deployments mix them: a law firm runs a cloud
# chat model and keeps embeddings local so document text never leaves the
# building, and a government install runs everything local.
#
# Each role falls back to LLM_PROVIDER when it names no provider of its own,
# so the common case stays one variable.
#
# openai | anthropic | google | mistral | ollama | vllm
LLM_PROVIDER=openai
# Leave blank for providers that need no key, such as a local ollama or vllm.
LLM_API_KEY=
# An OpenAI-compatible base URL to route everything through instead of the
# provider's own: a LiteLLM proxy, a gateway, an air-gapped mirror.
# LLM_BASE_URL=
#
# Nothing below is set, which means **no embedding model is configured** — and
# that is a deliberately supported state rather than a half-finished one. A
# document still parses, still chunks, and its passages are still searchable by
# keyword; they simply have no vectors until you name a model and run a reindex
# (`POST /api/documents/:id/reindex`). It is the same shape as SMTP_URL being
# unset below: the feature degrades to something coherent and says so, so that
# `cp .env.example .env && docker compose up` is a working stack rather than one
# that needs an API key before it will finish a job.
#
# For a cloud index, set LLM_API_KEY above and leave EMBEDDING_MODEL blank to
# take the provider default (text-embedding-3-large on OpenAI). For a local one,
# start the `local-llm` profile and set:
#
#   LLM_PROVIDER=ollama
#   EMBEDDING_MODEL=ollama/bge-m3
#
# CHAT_PROVIDER=
LLM_CHAT_MODEL=
# EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# RERANK_PROVIDER=
# RERANK_MODEL=
#
# The vision role does two jobs. It describes extracted figures, so that what a
# chart says can be searched for (used only when an upload sets `llm: true`);
# and since Phase 12.3 it is the advanced parser, reading a whole page into
# structured elements when an upload asks for `quality: "advanced"` or when a
# recognised page comes back below TIER_FALLBACK_THRESHOLD.
#
# Leaving it unset is a supported state for the first job and a refusal for the
# second: figures are still extracted, stored and located and simply have no
# caption, while `quality: "advanced"` is turned away at intake with a message
# naming these two variables.
#
# This is the one role that sends document *pixels* to a provider. Under
# OFFLINE_MODE a cloud one fails the process at boot, as it does for every other
# role — and the local answer is Qwen2.5-VL, which is what an unset
# VISION_MODEL resolves to on `ollama`. Not Llama 3.2 Vision: it can describe an
# image and cannot return a bounding box, and a page read without boxes produces
# elements nothing can cite.
#
#   VISION_PROVIDER=ollama
#   VISION_MODEL=ollama/qwen2.5vl:7b
#
# VISION_PROVIDER=
# VISION_MODEL=
#
# The width of the vectors the embedding model returns. It must equal the
# `chunks.embedding` column's declared dimension: pgvector needs a fixed width
# to build an HNSW index, so the column is `vector(1024)` and a model returning
# anything else cannot be stored. 1024 is BGE-M3's native width and a width
# text-embedding-3-large supports through Matryoshka truncation, which is what
# makes cloud and local interchangeable behind one column. Changing it means a
# migration *and* a reindex of every document.
EMBEDDING_DIMENSIONS=1024
# Passages per embedding request.
EMBEDDING_BATCH_SIZE=64
#
OLLAMA_BASE_URL=http://localhost:11434
# vLLM serves whatever model was loaded into it, so there is no default.
# VLLM_BASE_URL=
#
# Attempts per model call (the first included), per-call deadlines, and the
# circuit breaker. The breaker is what stops a queue of a hundred documents
# from discovering one provider outage a hundred times, one timeout each.
MODEL_MAX_RETRIES=3
MODEL_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=120
MODEL_BREAKER_FAILURES=5
MODEL_BREAKER_COOLDOWN_SECONDS=30
#
# When true, any attempt to reach a non-local endpoint raises immediately. This
# is a headline claim of the project and it is tested: a cloud provider named
# for *any* role fails the process at boot rather than sending the first
# document to the internet. Set it with a local provider:
#
#   OFFLINE_MODE=true
#   LLM_PROVIDER=ollama
#   EMBEDDING_MODEL=ollama/bge-m3
OFFLINE_MODE=false

# ------------------------------------------------------ Phase 08 — chunking --
# Chunk quality dominates answer quality — more than model choice, more than
# prompt wording — so the band is configuration rather than a constant.
#
# 600 to 900 tokens is where a passage is long enough to answer a question on
# its own and short enough that eight of them fit in a prompt with room for an
# answer. Tokens are counted with the configured embedding model's own
# tokenizer, so the numbers mean the same thing whichever model is in use.
# CHUNK_MAX_TOKENS is a hard ceiling: a table is the only thing allowed past it,
# because a table is never split.
CHUNK_TARGET_TOKENS=800
CHUNK_MIN_TOKENS=600
CHUNK_MAX_TOKENS=900
# Fraction of a chunk repeated at the head of the next, so a sentence
# straddling a boundary stays retrievable from either side.
CHUNK_OVERLAP_RATIO=0.15

# ----------------------------------------------------- Phase 09 — retrieval --
# A question goes to both a vector search and a keyword search, the two ranked
# lists are fused with Reciprocal Rank Fusion, and the result is reranked. Each
# stage below can be turned off independently, and retrieval still works with
# every one of them off — it is then plain fusion, which is the floor.

# Cross-encoder reranking after fusion: the largest quality gain per dollar in
# the pipeline, and also the only stage that adds a model call to every query.
# Set to false to skip straight from fusion to the top 8. It is *already* a
# pass-through when no rerank model resolves, so leaving this true on a stack
# with no RERANK_MODEL costs nothing.
RERANK_ENABLED=true

# Hypothetical Document Embeddings: ask the chat model to write the answer it
# expects, embed that instead of the question, and search with it. Measurably
# helps a small corpus, because a hypothetical answer sits closer to a passage
# than a question does. Costs one chat call per query, so it is off by default.
HYDE_ENABLED=false

# Expand a corpus query into three variants and fuse their results. Also one
# chat call per query. Off by default; it earns its keep on vague questions
# against a large corpus.
MULTI_QUERY_ENABLED=false

# Above this many documents in a corpus, retrieval searches document summaries
# first and confines the chunk search to the best ten documents. Below it, every
# chunk in the corpus is searched directly, which is both faster and better.
CORPUS_TWO_STAGE_THRESHOLD=200

# How much of the HNSW graph a vector search explores. Higher finds more true
# nearest neighbours and takes longer; lower returns sooner and misses more.
# The measured tradeoff is in `evals/RESULTS.md`; 40 is the default because on
# the 100k-chunk benchmark it is indistinguishable in latency from 20 and gives
# up nothing worth having. Applied with SET LOCAL inside the query's own
# transaction, so it never leaks onto a pooled connection.
HNSW_EF_SEARCH=40

# ------------------------------------------------------ Phase 13 — billing --
BILLING_ENABLED=false
# unlimited | metered
CREDITS_MODE=unlimited

# ------------------------------------------------------ Phase 12 — telemetry --
# Document text must never reach error reporting.
# SENTRY_DSN=

# ============================================================================
# Compose-only knobs
#
# These are read by `docker-compose.yml` when it builds the containers' own
# connection strings; no application code sees them. Changing a credential here
# means changing it in the matching URL above as well.
# ============================================================================

POSTGRES_USER=konusbitr
POSTGRES_PASSWORD=konusbitr
POSTGRES_DB=konusbitr
POSTGRES_PORT=5432

REDIS_PORT=6379

# The MinIO superuser. `minio-init` uses it once, to create the bucket and the
# unprivileged S3_ACCESS_KEY_ID above; nothing else ever authenticates as root.
MINIO_ROOT_USER=konusbitr-root
MINIO_ROOT_PASSWORD=konusbitr-root-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

WEB_PORT=3000

# Pulled by the `local-llm` profile so that a fully offline stack has a chat and
# an embedding model ready on first run.
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# bge-m3, not nomic-embed-text: 1024 dimensions, which is the width the
# `chunks.embedding` column is declared at. nomic-embed-text returns 768, and a
# 768-wide vector cannot be stored in a `vector(1024)` column — the worker
# refuses the write and names EMBEDDING_DIMENSIONS. BGE-M3 is also
# multilingual, which the corpus this product indexes is.
OLLAMA_EMBEDDING_MODEL=bge-m3
# The local vision model, pulled alongside the other two. Qwen2.5-VL is the one
# of the open vision models that returns *coordinates*, which is what Phase
# 12.3's advanced parser needs and what a description-only model cannot give:
# an element with no box cannot be cited. Roughly 6GB; comment it out if you
# only want chat and embeddings offline.
OLLAMA_VISION_MODEL=qwen2.5vl:7b
