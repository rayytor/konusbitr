# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# PDF.js runtime data (cMaps, standard fonts, WASM decoders), copied out of the
# installed package by `scripts/copy-pdfjs-assets.mjs` before dev and build so
# that they are served from our own origin rather than a CDN. Version-locked to
# the lockfile, so committing them would only be a second copy to keep in step.
apps/web/public/pdfjs/

# Caches
.turbo/
.cache/
.eslintcache
.ruff_cache/
.pytest_cache/
.mypy_cache/
coverage/
htmlcov/
.coverage

# Environment
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local data. The Compose stack keeps state in named volumes, but a bind-mounted
# ./data is a common local variation.
/data/

# Per-machine Compose tweaks (extra ports, a GPU device, a different image).
# Compose merges this automatically and it is nobody else's business.
docker-compose.override.yml
docker-compose.override.yaml

# Playwright
apps/web/e2e/.results/
apps/web/playwright-report/
apps/web/test-results/
apps/web/e2e/.auth/

# Personal desktop-launcher integration (machine-specific absolute paths).
/launch.sh
/konusbitr.desktop
/icon.svg
/icon_DARK.svg
/icon_LIGHT.svg
