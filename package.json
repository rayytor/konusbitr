{
  "name": "konusbitr",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hostable alternative to PDF.ai",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "./scripts/dev.sh",
    "dev:web": "turbo run dev --filter @konusbitr/web",
    "dev:worker": "cd services/worker && uv run python -m konusbitr_worker",
    "dev:infra": "./scripts/infra.sh up",
    "infra:up": "./scripts/infra.sh up",
    "infra:stack": "./scripts/infra.sh stack",
    "infra:migrate": "./scripts/infra.sh migrate",
    "infra:down": "./scripts/infra.sh down",
    "infra:reset": "./scripts/infra.sh reset",
    "infra:logs": "./scripts/infra.sh logs",
    "infra:ps": "./scripts/infra.sh ps",
    "infra:psql": "./scripts/infra.sh psql",
    "infra:wait": "./scripts/infra.sh wait",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:migrate": "pnpm --filter @konusbitr/db db:migrate",
    "db:seed": "pnpm --filter @konusbitr/db db:seed",
    "codegen": "echo 'TODO: Zod → pydantic codegen'",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
