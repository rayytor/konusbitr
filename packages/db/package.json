{
  "name": "@konusbitr/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./queries": "./src/queries/api-keys.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "clean": "rm -rf .turbo node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.3.0",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@konusbitr/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^11.1.0",
    "drizzle-kit": "^0.31.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
